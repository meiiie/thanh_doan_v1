# Non-secret production configuration. Install as /etc/neko-doan/neko-doan.env
# with mode 0640. Passwords belong in NEKO_SECRETS_DIR, never in this file.

COMPOSE_PROJECT_NAME=neko-doan
APP_DOMAIN=doan.example.vn
ACME_EMAIL=ops@example.vn
NEKO_SECRETS_DIR=/etc/neko-doan/secrets

# Release images must be immutable digest references. Never use latest.
POSTGRES_IMAGE=postgres:18-alpine@sha256:replace-with-reviewed-digest
EDGE_IMAGE=caddy:2-alpine@sha256:replace-with-reviewed-digest
BACKEND_IMAGE=ghcr.io/your-organization/neko-doan-backend@sha256:replace-with-release-digest
FRONTEND_IMAGE=ghcr.io/your-organization/neko-doan-frontend@sha256:replace-with-release-digest

POSTGRES_DB=campaign
POSTGRES_USER=campaign
CAMPAIGN_DB_POOL_MAX=10
CAMPAIGN_DB_POOL_MIN=2

# Enable only for the first controlled startup. Disable immediately after the
# Superadmin account has been verified and its password changed.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_USERNAME=superadmin
APP_BOOTSTRAP_DISPLAY_NAME="Quản trị hệ thống"

# Conservative defaults for a 4 GiB pilot VPS. Re-measure before changing.
DATABASE_CPU_LIMIT=1.0
DATABASE_MEMORY_LIMIT=1536m
BACKEND_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=1280m
FRONTEND_CPU_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=192m
EDGE_CPU_LIMIT=0.50
EDGE_MEMORY_LIMIT=192m
