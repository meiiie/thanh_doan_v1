# Copy to .env for the local production-like stack. Never commit .env.
APP_PORT=4318
POSTGRES_DB=campaign
POSTGRES_USER=campaign
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Enable only for the first startup. Disable after the Superadmin account exists.
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_USERNAME=superadmin
APP_BOOTSTRAP_PASSWORD=replace-with-a-15-to-72-character-one-time-password
APP_BOOTSTRAP_DISPLAY_NAME=Quản trị hệ thống

# Keep false only for local HTTP. Production behind HTTPS must set true.
APP_SESSION_COOKIE_SECURE=false

